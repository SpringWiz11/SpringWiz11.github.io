@inproceedings{sharma2025claim,
  abbr         = {CLEF},
  title        = {TIFIN at CheckThat! 2025: Reasoning-Guided Claim Normalization for Noisy Multilingual Social Media Posts},
  author       = {Sharma, Manan and Suneesh, Arya and Jain, Manish and Rajpoot, Pawan Kumar and Devadiga, Prasanna and Hazarika, Bharatdeep and Shrivastava, Ashish and Gurumurthy, Kishan and Suresh, Anshuman B and Baliga, Aditya U},
  booktitle    = clef,
  year         = {2025},
  bibtex_show  = {true},
  arxiv        = {2511.05078},
  html         = {https://ceur-ws.org/Vol-4038/paper_95.pdf},
  award        = {3rd place, English leaderboard},
  abstract     = {Transforming noisy social media posts into clear, verifiable statements across 20 languages. Systematic 5W1H decomposition enables robust cross-lingual transfer despite training exclusively on English data, using a LoRA fine-tuned Qwen3-14B with retrieval-augmented few-shot prompting and token-level recall filtering. Ranked 3rd on the English leaderboard and 4th on Dutch and Punjabi.}
