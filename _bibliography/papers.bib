@article{gurumurthy2026atlas,
  abbr         = {arXiv},
  title        = {Geometric Function Atlas: Certified Computing for Geometric Function Theory in Python},
  author       = {Gurumurthy, Kishan and Devadiga, Pushparaj and Devadiga, Prasanna and Suneesh, Arya and Sebastian, Asha},
  journal      = {arXiv preprint arXiv:2609.07969},
  year         = {2026},
  selected     = {true},
  bibtex_show  = {true},
  arxiv        = {2609.07969},
  abstract     = {An open-source Python package for the sharp extremal problems of geometric function theory, organized around a catalogue of thirty-nine Ma-Minda starlike generators. A three-tier verification approach -- a floating-point grid screen, an exact sufficient condition decided in rational arithmetic, and a certified interval enclosure -- backs every result with an evidence level and an artifact identifier. The distribution ships three hundred and six coefficient certificates and seven hundred and two directed inclusion radii. Released under the MIT license on PyPI.}
}

