@inproceedings{hazarika2025xverify,
  abbr         = {CLEF},
  title        = {TIFIN at CheckThat! 2025: X-VERIFY -- Multi-lingual NLI-based Fact Checking with Condensed Evidence},
  author       = {Hazarika, Bharatdeep and Devadiga, Prasanna and Rajpoot, Pawan Kumar and Baliga, Aditya U and Gurumurthy, Kishan and Jain, Manish and Sharma, Manan and Shrivastava, Ashish and Suneesh, Arya and Suresh, Anshuman B},
  booktitle    = clef,
  year         = {2025},
  bibtex_show  = {true},
  html         = {https://ceur-ws.org/Vol-4038/paper_74.pdf},
  award        = {3rd place, English and Arabic tracks},
  abstract     = {Verifying numerical claims as True, False, or Conflicting from retrieved evidence. The pipeline combines optimized evidence selection, LLM-based summarization with IBM Granite 3.3 8B, and a LoRA fine-tuned DeBERTa-large classifier. Multilingual augmentation lifts macro-F1 from 0.5815 to 0.6859, a 17.95% relative gain. Ranked 3rd in both English and Arabic.}
}
