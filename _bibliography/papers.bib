@article{gurumurthy2025federated,
  abbr         = {TMLR},
  title        = {Federated Spectral Graph Transformers Meet Neural Ordinary Differential Equations for Non-IID Graphs},
  author       = {Gurumurthy, Kishan and Pal, Himanshu and Sharma, Charu},
  journal      = tmlr,
  year         = {2025},
  selected     = {true},
  bibtex_show  = {true},
  arxiv        = {2504.11808},
  html         = {https://openreview.net/forum?id=TR6iUG8i6Z},
  code         = {https://github.com/SpringWiz11/Fed-GNODEFormer},
  abstract     = {Centralizing large volumes of real-world graph data for GNN training is often impractical due to privacy concerns. We propose Fed-GNODEFormer, which couples spectral GNNs with neural ordinary differential equations to handle non-IID data distributions in federated settings. The method delivers significant improvements on non-IID heterophilic graphs while remaining competitive on homophilic datasets, with applications to social network analysis, recommendation, and fraud detection.}
}

@article{devadiga2025universal,
  abbr         = {TMLR},
  title        = {Universal Differential Equations for Stable Multi-Step Volatility Time Series Forecasting},
  author       = {Devadiga, Prasanna and Gurumurthy, Kishan and Mohan, Kshitij},
  journal      = tmlr,
  year         = {2025},
  selected     = {true},
  bibtex_show  = {true},
  html         = {https://openreview.net/forum?id=uWGNexco2M},
  abstract     = {We present a systematic study of Universal Differential Equations for financial volatility forecasting, a domain marked by regime shifts, heavy tails, and jump discontinuities. UDEs extend Neural ODEs by embedding mechanistic structure within learned dynamics, parameterizing coefficients of a partially known differential equation rather than learning the system purely from data. Across market regimes our variants outperform both continuous-time baselines and discrete-time models, achieving higher accuracy and greater long-horizon stability while remaining interpretable.}
}

@inproceedings{lal2025eventtempex,
  abbr         = {FIRE},
  title        = {EventTempEx: A Tool for Interpreting Event-Anchored Temporal Expressions},
  author       = {Lal, Niharika and Rajpoot, Pawan Kumar and Gurumurthy, Kishan and Omar, Nadia},
  booktitle    = {Proceedings of the 17th Annual Meeting of the Forum for Information Retrieval Evaluation (FIRE)},
  year         = {2025},
  bibtex_show  = {true},
  code         = {https://github.com/SpringWiz11/EventTempEx},
  abstract     = {Temporal expressions that anchor to events rather than to the calendar resist standard normalization. We classify temporal references into standard, event-contextual, complex, and historic types using a fine-tuned DeBERTa NER model, combining a Duckling parser for standard references with semantic-search backends for event-contextual ones.}
}

